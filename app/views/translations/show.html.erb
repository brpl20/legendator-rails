<%# Poll for payment/translation progress. A plain <meta refresh> would wipe
    whatever the customer is typing into the context box, so the reload is done
    in JS and skipped while that field is being edited or holds unsaved text. %>
<% if @translation.pending_payment? || @translation.paid? || @translation.processing? %>
  <% content_for :head do %>
    <script>
      (function () {
        var INTERVAL = 5000;
        function editing() {
          var box = document.getElementById("context-box");
          if (!box) return false;
          if (document.activeElement === box) return true;
          return box.value !== box.dataset.saved;
        }
        setInterval(function () {
          if (!editing()) window.location.reload();
        }, INTERVAL);
      })();
    </script>
  <% end %>
<% end %>

<div class="max-w-xl mx-auto">
  <%# Recovery code %>
  <div class="rounded-xl bg-slate-800/60 border border-slate-700 p-6 mb-8 text-center">
    <p class="text-sm text-slate-400 mb-1">Seu codigo de recuperacao</p>
    <p class="text-2xl font-mono font-bold text-emerald-400 tracking-wider"><%= @translation.formatted_code %></p>
    <p class="text-xs text-slate-500 mt-2">Este codigo aparecera no seu extrato bancario.</p>
  </div>

  <%# Status-dependent content %>
  <% if @translation.pending_payment? %>
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-white mb-2">Pagamento Pendente</h1>
      <p class="text-3xl font-bold text-emerald-400">R$ <%= "%.2f" % @translation.cost_brl %></p>
    </div>

    <%# What we read from the opening of the file, plus the context the customer
        can still refine. Editable only while payment is pending. %>
    <% if @translation.detected_title.present? || @translation.detected_summary.present? %>
      <div class="rounded-xl p-6 mb-6" style="background: rgba(124, 58, 237, 0.08); border: 1px solid rgba(124, 58, 237, 0.3);">
        <p class="text-xs tracking-widest uppercase mb-2" style="color: var(--toku-gold);">O que identificamos</p>
        <% if @translation.detected_title.present? %>
          <p class="text-lg font-semibold text-white mb-1"><%= @translation.detected_title %></p>
        <% end %>
        <% if @translation.detected_summary.present? %>
          <p class="text-sm" style="color: var(--toku-silver);"><%= @translation.detected_summary %></p>
        <% end %>
        <p class="text-xs mt-3" style="color: rgba(203, 213, 225, 0.6);">
          <%= @translation.subtitle_count %> legendas · <%= Translation::SUPPORTED_LANGUAGES[@translation.target_language] %>
        </p>
      </div>
    <% end %>

    <div class="rounded-xl p-6 mb-8" style="background: rgba(12, 10, 26, 0.6); border: 1px solid rgba(124, 58, 237, 0.2);">
      <%= form_with model: @translation, url: update_context_translation_path(@translation), method: :patch, class: "space-y-3" do |f| %>
        <%= f.label :context, "Contexto para a traducao", class: "block text-sm tracking-wider", style: "color: var(--toku-gold);" %>
        <p class="text-xs" style="color: rgba(203, 213, 225, 0.6);">
          Nomes de personagens, apelidos, tom da obra. Vale para o arquivo inteiro.
          Da para ajustar ate o pagamento.
        </p>
        <%# data-saved lets the poller tell "unsaved edits" from "untouched". %>
        <%= f.text_area :context, rows: 3,
            id: "context-box",
            maxlength: Translation::MAX_CONTEXT_LENGTH,
            data: { saved: @translation.context.to_s },
            class: "block w-full rounded-lg px-4 py-2.5 text-sm",
            style: "background: var(--toku-dark); border: 1px solid rgba(124, 58, 237, 0.3); color: var(--toku-silver);" %>
        <%= f.submit "Salvar contexto",
            class: "rounded-lg px-5 py-2 text-sm font-semibold tracking-wider uppercase cursor-pointer",
            style: "color: var(--toku-silver); border: 1px solid rgba(124, 58, 237, 0.4); background: transparent;" %>
      <% end %>
    </div>

    <% if @translation.payment&.pix_qr_code_base64.present? %>
      <div class="flex justify-center mb-6">
        <img src="data:image/png;base64,<%= @translation.payment.pix_qr_code_base64 %>"
             alt="QR Code PIX"
             class="w-56 h-56 rounded-lg bg-white p-2">
      </div>
    <% end %>

    <% if @translation.payment&.pix_copia_e_cola.present? %>
      <div class="mb-6">
        <label class="block text-sm font-medium text-slate-400 mb-1">PIX Copia e Cola</label>
        <div class="flex">
          <input type="text" readonly value="<%= @translation.payment.pix_copia_e_cola %>"
                 class="flex-1 rounded-l-lg bg-slate-800 border border-slate-600 text-slate-200 px-4 py-2.5 text-sm font-mono truncate">
          <button onclick="navigator.clipboard.writeText(this.previousElementSibling.value)"
                  class="rounded-r-lg bg-slate-700 border border-l-0 border-slate-600 px-4 py-2.5 text-sm font-medium text-slate-300 hover:bg-slate-600 transition">
            Copiar
          </button>
        </div>
      </div>
    <% end %>

    <% if Rails.env.development? %>
      <div class="mt-6 text-center">
        <%= button_to "Simular Pagamento (DEV)", simulate_payment_path(@translation),
            class: "toku-btn-primary inline-block rounded-lg px-6 py-2 text-sm font-semibold text-white tracking-wider uppercase cursor-pointer",
            data: { turbo_confirm: "Simular pagamento de R$ #{"%.2f" % @translation.cost_brl}?" } %>
      </div>
    <% end %>

  <% elsif @translation.paid? || @translation.processing? %>
    <div class="text-center py-12">
      <div class="inline-block w-10 h-10 border-4 border-emerald-400 border-t-transparent rounded-full animate-spin mb-6"></div>
      <h1 class="text-2xl font-bold text-white mb-2">Traduzindo...</h1>
      <p class="text-slate-400">Seu arquivo esta sendo traduzido. Esta pagina atualiza automaticamente.</p>
    </div>

  <% elsif @translation.completed? %>
    <div class="text-center py-12">
      <h1 class="text-2xl font-bold text-emerald-400 mb-2">Pronto!</h1>
      <p class="text-slate-400 mb-8">Sua traducao esta disponivel para download.</p>
      <%= link_to "Baixar arquivo traduzido", download_translation_path(@translation),
          class: "inline-block rounded-lg bg-emerald-600 px-8 py-3 text-base font-semibold text-white shadow hover:bg-emerald-500 transition" %>
    </div>

  <% elsif @translation.failed? %>
    <div class="text-center py-12">
      <h1 class="text-2xl font-bold text-red-400 mb-2">Erro na traducao</h1>
      <p class="text-slate-400">Ocorreu um erro ao processar sua traducao. Por favor, tente novamente.</p>
    </div>

  <% elsif @translation.expired? %>
    <div class="text-center py-12">
      <h1 class="text-2xl font-bold text-yellow-400 mb-2">Traducao expirada</h1>
      <p class="text-slate-400">Esta traducao expirou. Por favor, crie uma nova.</p>
    </div>
  <% end %>

  <div class="mt-10 text-center">
    <%= link_to "Traduzir outra", new_translation_path,
        class: "text-sm text-slate-400 hover:text-white transition" %>
  </div>
</div>
